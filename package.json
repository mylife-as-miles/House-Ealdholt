{
  "name": "house-ealdholt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "assets:village:verify": "node scripts/install-private-village.mjs --verify-only",
    "build": "npm --prefix \"main game\" run build:house",
    "preview": "npm --prefix \"main game\" run preview:house",
    "typecheck": "npm --prefix \"main game\" run typecheck",
    "test:core": "node --import tsx --test shared/legacy/aethelgard/characters/village-population-runtime.test.ts \"main game/src/legacy/aethelgard/characters/crowd-residents.test.ts\" \"main game/src/legacy/aethelgard/building-emergency-sites.test.ts\"",
    "assets:house:install": "node scripts/install-house-private.mjs",
    "test:market": "node --import tsx --test shared/legacy/aethelgard/observer/market-economy.test.ts shared/legacy/aethelgard/observer/market-village.test.ts",
    "test:npc-ai": "node --import tsx --test server/npc-ai/handler.test.ts server/npc-ai/local-quota.test.ts server/npc-ai/d1-quota.test.ts server/npc-ai/site-handler.test.ts 'main game/src/legacy/aethelgard/observer/resident-conversation-client.test.ts'",
    "npc-ai:local": "node --import tsx server/npc-ai/local-server.ts",
    "test:chunks": "node --import tsx --test 'main game/src/legacy/aethelgard/chunked-village-model.test.ts' scripts/split-village-model.test.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "meshoptimizer": "1.1.1",
    "sharp": "0.35.4",
    "tsx": "4.21.0"
  }
}
